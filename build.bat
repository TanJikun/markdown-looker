@echo off
chcp 65001 >nul
title Markdown Looker 一键编译

:: 切换到脚本所在的当前目录
cd /d "%~dp0"

echo ===================================================
echo 正在准备编译 Markdown Looker...
echo 提示：由于之前已经编译过依赖，本次编译预计只需几秒到十几秒。
echo ===================================================
echo.

:: 执行 Tauri 编译命令
call tauri build

:: 检查上一条命令是否执行成功
if %errorlevel% neq 0 (
    echo.
    echo ===================================================
    echo [错误] 编译失败！
    echo 请检查上方是否有红色的报错信息（如代码修改有误）。
    echo ===================================================
    pause
    exit /b
)

echo.
echo ===================================================
echo [成功] 编译完成！正在为你打开程序所在文件夹...
echo ===================================================

:: 自动打开输出文件夹
explorer "src-tauri\target\release"

echo.
echo 编译已全部结束。
:: 使用系统自带的 pause，接收任意键（主键盘/小键盘均可）
pause
exit