{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markdown-looker",
  "version": "0.1.0",
  "identifier": "com.littlecode.markdownlooker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Markdown Looker",
        "label": "main",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}